{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier -w .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "lucide-react": "^0.548.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@babel/code-frame": "7.27.1",
    "@babel/eslint-parser": "7.28.4",
    "@types/node": "20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0 --format ./eslint-formatter.cjs ",
      "prettier -w"
    ],
    "*.{css,md,json}": [
      "prettier -w"
    ]
  }
}
