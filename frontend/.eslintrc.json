{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "presets": ["next/babel"]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "build/",
    "frontend/node_modules/",
    "backend/",
    "coverage/"
  ],
  "rules": {
    "import/no-cycle": ["error", { "ignoreExternal": true, "maxDepth": 10 }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@features/*/*",
              "@features/*/**",
              "@lib/*/*",
              "@lib/*/**",
              "@components/*/*",
              "@components/*/**",
              "@data/*/*",
              "@data/*/**",
              "@i18n/*/*",
              "@i18n/*/**",
              "@table_config/*/*",
              "@table_config/*/**",
              "@types/core/*",
              "@types/ui/*",
              "@types/*",
              "@utils/*/*",
              "@utils/*/**",
              "@hook/*/*"
            ],
            "message": "Importuj cez barrel (t.j. <alias>/<modul>), nie priamo zo súborov."
          }
        ]
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "typescript": { "project": "tsconfig.json" }
    }
  }
}
