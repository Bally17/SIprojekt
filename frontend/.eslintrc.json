{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "presets": ["next/babel"]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "build/",
    "frontend/node_modules/",
    "backend/",
    "coverage/"
  ],
  "rules": {
    "import/no-cycle": ["error", { "ignoreExternal": true, "maxDepth": 10 }]
  }
}
